#!/bin/bash
#
# Wrapper to execute SST-CONFIG using Valgrind
#
#

SSTCONFIG_BIN="@SSTCONFIG@"
EXE="valgrind --error-exitcode=99 $SSTCONFIG_BIN"

if ! command -v valgrind &> /dev/null; then
  echo "Error: valgrind executable not found" >&2
  echo "Please install valgrind to continue" >&2
  exit 1
fi

$EXE $@
exit $?
