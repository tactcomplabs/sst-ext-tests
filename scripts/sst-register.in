#!/bin/bash
#
# Wrapper to execute SST-REGISTER using Valgrind
#
#

SSTREGISTER_BIN="@SSTREGISTER@"
EXE="valgrind --error-exitcode=99 $SSTREGISTER_BIN"

if ! command -v valgrind &> /dev/null; then
  echo "Error: valgrind executable not found" >&2
  echo "Please install valgrind to continue" >&2
  exit 1
fi

$EXE $@
exit $?
